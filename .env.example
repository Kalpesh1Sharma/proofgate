# Copy to .env.local for local development, and set the same variables in your
# deployment (Vercel) with server-only scope. Never prefix these with
# NEXT_PUBLIC_: anything with that prefix is bundled into the browser.
#
# The AI Fix Advisor is disabled when either value is missing. There is no
# fallback model; GROQ_MODEL is sent to Groq verbatim.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
